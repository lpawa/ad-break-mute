{
  "manifest_version": 3,
  "name": "Ad Break Mute",
  "version": "0.7.1",
  "description": "Mutes and covers ad breaks while you stream, counts them, and tells you when the show is back. Supports JioHotstar and Prime Video.",
  "permissions": [
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "*://*.hotstar.com/*",
    "*://*.primevideo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.hotstar.com/*"
      ],
      "js": [
        "sites/hotstar/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.hotstar.com/*"
      ],
      "js": [
        "sites/hotstar/site.js",
        "core/content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.primevideo.com/*"
      ],
      "js": [
        "sites/primevideo/site.js",
        "sites/primevideo/page.js",
        "core/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ad Break Mute",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
